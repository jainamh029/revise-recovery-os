# SQLite locally, PostgreSQL in production-like setups
DATABASE_URL=sqlite:///./recovery_os.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/recovery_os
CORS_ORIGINS=http://localhost:3000
# Freeze "today" for a reproducible demo (YYYY-MM-DD). Leave empty to use the real date.
DEMO_TODAY=
# Demo-only authorization default (the X-Role header is spoofable; this is NOT authentication)
DEFAULT_ROLE=approver
# Enables POST /api/admin/reseed for the end-to-end tests. Never enable outside local/test environments.
ALLOW_RESEED=false
